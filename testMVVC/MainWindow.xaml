<Window x:Class="testMVVC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:testMVVC"
        xmlns:viewmodel="clr-namespace:testMVVC.ViewModels"
        mc:Ignorable="d"
        Title="Gestion des Offres de stage" Height="500" Width="950"
        WindowStartupLocation="CenterScreen">

    <!-- 1. CONNEXION INVISIBLE : On dit à la Vue d'utiliser notre ViewModel d'affichage -->
    <Window.DataContext>
        <viewmodel:OffreListeViewModel />
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>         <!-- Zone des boutons -->
            <RowDefinition Height="*"/>            <!-- Zone du tableau -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Zone des boutons -->
                    <ColumnDefinition Width="*"/>
                    <!-- Zone du tableau -->
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Offre de Stage" Margin="5 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Champ de saisie lié au ViewModel (UpdateSourceTrigger=PropertyChanged applique le filtre à chaque touche tapée) -->
                    <TextBox Text="{Binding TexteRecherche, UpdateSourceTrigger=PropertyChanged}"
                         Width="200" Height="35"
                         Background="Transparent" 
                         BorderThickness="1" 
                         VerticalAlignment="Center"
                         FontSize="12"
                         Foreground="#333333"
                         Margin="0 0 5 0"/>
                    <!-- FILTRE PAR STATUT (MENU DÉROULANT) -->
                    <ComboBox Width="180" 
                          Height="35" 
                          SelectedIndex="0"
                          BorderBrush="#D0D5DD"
                          BorderThickness="1"
                          Margin="0 0 50 0">

                        <!-- Style pour arrondir le ComboBox à l'identique de l'image -->
                        <ComboBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </ComboBox.Resources>

                        <!-- Éléments de la liste -->
                        <ComboBoxItem Content="Tous les statuts"/>
                        <ComboBoxItem Content="Ouverte"/>
                        <ComboBoxItem Content="Fermée"/>
                        <ComboBoxItem Content="Annulée"/>
                    </ComboBox>
                    <Button Content="Rafraîchir" 
                        Command="{Binding ChargerOffresCommand}" 
                        Padding="15,7" Margin="0,0,10,0"
                        Background="#2196F3" Foreground="White" FontWeight="Bold" BorderThickness="0"/>

                    <Button Content="Ajouter" 
                        Command="{Binding AjouterCommand}" 
                        Padding="15,7" Margin="0,0,10,0"
                        Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderThickness="0"/>

                    <!-- Ce bouton se grisera TOUT SEUL si aucune ligne n'est sélectionnée grâce à votre RelayCommand -->
                    <Button Content="Supprimer" 
                        Command="{Binding SupprimerCommand}" 
                        Padding="15,7"
                        Background="#F44336" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </StackPanel>
            </Grid>
            
        </StackPanel>

        <!-- LE TABLEAU DE DONNÉES (DataGrid) -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Offres}" 
                  SelectedItem="{Binding OffreSelectionnee}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  BorderBrush="#CCCCCC"
                  RowHeight="30"
                  AlternatingRowBackground="#F9F">

            <DataGrid.Columns>
                <!-- Chaque colonne va "aspirer" la propriété correspondante de l'objet OffreStage -->
                <DataGridTextColumn Header="ID" Binding="{Binding IdOffre}" Width="Auto" />
                <DataGridTextColumn Header="Titre du Poste" Binding="{Binding TitreOffre}" Width="Auto" />
                <DataGridTextColumn Header="Description du Stage" Binding="{Binding DescriptionOffre}" Width="Auto" />
                <DataGridTextColumn Header="Durée" Binding="{Binding DureeOffre}" Width="100" />
                <DataGridTextColumn Header="Rémunération" Binding="{Binding RemunerationOffre}" Width="Auto" />
                <DataGridTextColumn Header="Statut" Binding="{Binding StatutOffre}" Width="Auto">

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <!-- Valeur par défaut : texte noir et en gras -->
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatutOffre}" Value="Ouverte">
                                    <Setter Property="Foreground" Value="#2E7D32" />
                                    <Setter Property="Background" Value="GreenYellow" />
                                    <Setter Property="Margin" Value="2" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="5" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatutOffre}" Value="Fermée">
                                    <Setter Property="Foreground" Value="#ff0000" />
                                    <Setter Property="Background" Value="#ff9999" />
                                    <Setter Property="Margin" Value="2" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                    <!-- Affiche la liste C# convertie sous forme de texte propre séparé par des virgules -->
                <DataGridTextColumn Header="Technologies requises" Binding="{Binding TechnologiesAffichage}" Width="*" />
                
                <!-- Gestion des boutons -->
                <DataGridTemplateColumn Header="Actions"  Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="👁" ToolTip="Voir les détails"/>
                                <Button Content="✏" ToolTip="Modifier l'offre"/>
                                <Button Content="🗑" ToolTip="Supprimer l'offre" Command="{Binding DataContext.SupprimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
